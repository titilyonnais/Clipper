{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipper",
  "version": "../package.json",
  "identifier": "com.clipper.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Clipper",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "resizable": true,
        "visible": false,
        "skipTaskbar": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "freezePrototype": true,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "titilyonnais",
    "homepage": "https://github.com/titilyonnais/Clipper",
    "copyright": "© 2026 titilyonnais — MIT",
    "category": "Productivity",
    "shortDescription": "Gestionnaire de presse-papiers",
    "longDescription": "Historique du presse-papiers local avec recherche, catégories et IA optionnelle.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": "fr-FR"
      }
    }
  }
}
