{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipper",
  "version": "../package.json",
  "identifier": "com.clipper.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Clipper",
        "width": 1180,
        "height": 760,
        "minWidth": 880,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "resizable": true,
        "visible": false,
        "skipTaskbar": false,
        "shadow": true,
        "backgroundColor": "#000000",
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-component-update --disk-cache-size=8388608 --disable-gpu-shader-disk-cache --force-color-profile=srgb"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "freezePrototype": true,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "titilyonnais",
    "homepage": "https://github.com/titilyonnais/Clipper",
    "copyright": "© 2026 titilyonnais — MIT",
    "category": "Productivity",
    "shortDescription": "Gestionnaire de presse-papiers",
    "longDescription": "Historique du presse-papiers local avec recherche, catégories et IA optionnelle.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh",
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": "fr-FR"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDQzg0RkJFMjNCRTZEMzkKUldRNWJiNGp2ay9JL0xwTk14WUZFQmtPSC94L1lYWDlCU1R6VnlUNWxUSW0xdWsvdzJUdG5HWmQK",
      "endpoints": [
        "https://github.com/titilyonnais/Clipper/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
